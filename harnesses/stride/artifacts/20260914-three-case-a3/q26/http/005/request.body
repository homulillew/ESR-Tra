ical terms. Returned excerpts are navigation only; use read(eN) to restore raw text. Notes are not evidence.","name":"recall","parameters":{"additionalProperties":false,"properties":{"query":{"maxLength":2000,"minLength":1,"pattern":"\\S","type":"string"}},"required":["query"],"type":"object"}},"type":"function"},{"function":{"description":"Optional small scratchpad, NOT verified facts or a prerequisite to finishing. Save only candidate distinctions, rejected paths or bridge clues useful later. Explicit replacement/deletion changes the current view; no claims are auto-verified.","name":"notes","parameters":{"oneOf":[{"additionalProperties":false,"properties":{"anchors":{"items":{"pattern":"^e[1-9][0-9]*$","type":"string"},"maxItems":6,"minItems":0,"type":"array","uniqueItems":true},"key":{"pattern":"^[A-Za-z0-9_-]{1,32}$","type":"string"},"op":{"const":"put"},"text":{"maxLength":600,"minLength":1,"pattern":"\\S","type":"string"}},"required":["op","key","text","anchors"],"type":"object"},{"additionalProperties":false,"properties":{"key":{"pattern":"^[A-Za-z0-9_-]{1,32}$","type":"string"},"op":{"const":"delete"}},"required":["op","key"],"type":"object"}]}},"type":"function"},{"function":{"description":"Submit the exact answer string with previously delivered eN evidence, or explicitly abstain. No prior note, draft, audit or cleanup is required. Select every raw window used for compound answer assertions; a legal reference is not entailment. Must be last in a batch; no automatic answer fixing.","name":"finish","parameters":{"oneOf":[{"additionalProperties":false,"properties":{"answer":{"maxLength":8000,"minLength":1,"pattern":"\\S","type":"string"},"refs":{"items":{"pattern":"^e[1-9][0-9]*$","type":"string"},"maxItems":16,"minItems":0,"type":"array","uniqueItems":true}},"required":["answer","refs"],"type":"object"},{"additionalProperties":false,"properties":{"abstain":{"const":true},"reason":{"maxLength":2000,"minLength":1,"pattern":"\\S","type":"string"}},"required":[