642279731131b"},{"content":"Current control state (data, not source evidence):\n{\"current_notes_not_evidence\":[],\"evidence_shelf\":{\"omitted_for_capacity\":[],\"restored_exact_windows\":[],\"selection\":\"bounded recent first-delivery order; not a relevance/verification judgment\"},\"feedback\":null,\"instruction\":\"Read only useful passages. Notes and all-page cleanup are optional.\",\"literal_answer_contract\":{\"origin\":\"explicit experiment configuration, not inferred from question\",\"prefix\":\"\",\"suffix\":\"\"},\"phase\":\"RESEARCH\",\"recent_document_index_not_evidence\":[],\"remaining\":{\"action_slots\":198,\"backend_calls\":114,\"model_calls\":63,\"output_reservation\":47892},\"retriever_capabilities\":{\"boolean_operators\":false,\"kind\":\"sqlite-fts5-bm25\",\"negative_result\":\"no hit for this expression is not proof that the fact is absent\",\"phrase_quotes\":false,\"query_rule\":\"lowercase; regex word extraction; first-occurrence deduplication; OR of quoted individual tokens\",\"ranking\":\"SQLite bm25(search), ascending; docid tie-break; unchanged from q26 LocalIndex\",\"scope\":\"fixed local corpus; not live web\",\"site_filter\":false,\"title_kind\":\"stored URL, not an extracted page title\",\"warning\":\"site:, quotes and AND/OR in input are not filters/operators. Their words may become ordinary search terms. Use a few discriminating terms.\"},\"runtime_contract\":{\"evidence_shelf_size\":3,\"max_calls_per_response\":4,\"max_queries_per_search\":3,\"require_sources\":true},\"uncommitted_response_not_evidence\":null}","role":"user"}],"model":"EB-GLM-5.2","temperature":0,"tool_choice":"auto","tools":[{"function":{"description":"Search up to three independent queries. Results are navigation, NOT raw evidence. No note or plan is required.","name":"search","parameters":{"additionalProperties":false,"properties":{"queries":{"items":{"maxLength":2000,"minLength":1,"pattern":"\\S","type":"string"},"maxItems":3,"minItems":1,"type":"array","uniqueItems":true},"top_k":{"maximum":10,"minimum":1,"type":"integer"}},"required":["queries"],"type":"object"}},"type":"function"},{"function":{"description":"Read a previously received document dN at exact Unicode code-point offsets, or replay an eN evidence window exactly. eN replay accepts no start/length. Never guess handles from unread results.","name":"read","parameters":{"additionalProperties":false,"properties":{"length":{"maximum":6000,"minimum":1,"type":"integer"},"ref":{"pattern":"^[de][1-9][0-9]*$","type":"string"},"start":{"minimum":0,"type":"integer"}},"required":["ref"],"type":"object"}},"type":"function"},{"function":{"description":"Locate literal text in a previously received document (case-sensitive by default; ignore_case=true uses Unicode regex case-insensitive matching, preserving original offsets). Positions/excerpts are navigation; call read at an issued position for citable raw evidence.","name":"find","parameters":{"additionalProperties":false,"properties":{"ignore_case":{"type":"boolean"},"ref":{"pattern":"^d[1-9][0-9]*$","type":"string"},"start":{"minimum":0,"type":"integer"},"text":{"maxLength":2000,"minLength":1,"pattern":"\\S","type":"string"}},"required":["ref","text"],"type":"object"}},"type":"function"},{"function":{"description":"Search previously delivered evidence, received search-hit navigation (when enabled), and note history by lexical terms. Returned excerpts are navigation only; use read(eN) to restore raw text. Notes are not evidence.","name":"recall","parameters":{"additionalProperties":false,"properties":{"query":{"maxLength":2000,"minLength":1,"pattern":"\\S","type":"string"}},"required":["query"],"type":"object"}},"type":"function"},{"function":{"description":"Optional small scratchpad, NOT verified facts or a prerequisite to finishing. Save only candidate distinctions, rejected paths or bridge clues useful later. Explicit replacement/deletion changes the current view; no claims are auto-verified.","name":"notes","parameters":{"oneOf":[{"additionalProperties":false,"properties":{"anchors":{"items":{"pattern":"^e[1-9][0-9]*$","type":"string"},"maxItems":6,"minItems":0,"type":"array","uniqueItems":true},"key":{"pattern":"^[A-Za-z0-9_-]{1,32}$","type":"string"},"op":{"const":"put"},"text":{"maxLength":600,"minLength":1,"pattern":"\\S","type":"string"}},"required":["op","key","text","anchors"],"type":"object"},{"additionalProperties":false,"properties":{"key":{"pattern":"^[A-Za-z0-9_-]{1,32}$","type":"string"},"op":{"const":"delete"}},"required":["op","key"],"type":"object"}]}},"type":"function"},{"function":{"description":"Submit the exact answer string with previously delivered eN evidence, or explicitly abstain. No prior note, draft, audit or cleanup is required. Select every raw window used for compound answer assertions; a legal reference is not entailment. Must be last in a batch; no automatic answer fixing.","name":"finish","parameters":{"oneOf":[{"additionalProperties":false,"properties":{"answer":{"maxLength":8000,"minLength":1,"pattern":"\\S","type":"string"},"refs":{"items":{"pattern":"^e[1-9][0-9]*$","type":"string"},"maxItems":16,"minItems":0,"type":"array","uniqueItems":true}},"required":["answer","refs"],"type":"object"},{"additionalProperties":false,"properties":{"abstain":{"const":true},"reason":{"maxLength":2000,"minLength":1,"pattern":"\\S","type":"string"}},"required":["abstain","reason"],"type":"object"}]}},"type":"function"}]}