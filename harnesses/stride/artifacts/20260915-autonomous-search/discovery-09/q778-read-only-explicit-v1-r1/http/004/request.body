nse, based only on evidence already received for that decision. Never combine a new read and a guessed citation to its unseen result. In FINAL only finish is allowed.","name":"finish","parameters":{"oneOf":[{"additionalProperties":false,"properties":{"answer":{"maxLength":8000,"minLength":1,"pattern":"\\S","type":["string","integer"]},"refs":{"items":{"pattern":"^e[1-9][0-9]*$","type":"string"},"maxItems":16,"minItems":0,"type":"array","uniqueItems":true}},"required":["answer","refs"],"type":"object"},{"additionalProperties":false,"properties":{"abstain":{"const":true},"reason":{"maxLength":2000,"minLength":1,"pattern":"\\S","type":"string"}},"required":["abstain","reason"],"type":"object"}]}},"type":"function"}]}