# ==============================================================
# Code-L 本地 git 仓库 .gitignore
# 原则：跟踪"代码 + 脚本 + 报告 + 当前活跃结果"；排除
#    缓存、临时文件、以及体积大且无 diff 价值的旧轨迹石库。
# ==============================================================

# ---- Python 缓存 / 构建 ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# ---- 虚拟环境（venv 在 Code-L 之外，以防万一仍排除） ----
.venv/
venv/
env/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
*~
.DS_Store

# ---- 日志（运行产物，易变、不入版本） ----
*.log

# ---- 旧的大体积轨迹石库（保留在磁盘，但不进 git） ----
# results/exp1 为实验1最早的 126M 轨迹数据库，diff 价值低、体积大
results/exp1/

# Private benchmark inputs, credentials-free raw requests, and local research receipts.
runs/strong_api_esr/
