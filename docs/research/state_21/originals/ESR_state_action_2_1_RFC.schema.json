{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESR State and Action Contract 2.1-RFC (PROPOSED, not deployed)",
  "description": "Syntax only. Context-dependent reference, exposure, scope, audit and transactional invariants are specified in the accompanying RFC. Caps are transport limits, not evidence-backed 4B optima.",
  "$defs": {
    "Claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S"
        },
        "requirement": {
          "type": "string",
          "maxLength": 1200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "finding": {
          "type": "string",
          "maxLength": 1200
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "claim_id",
        "requirement",
        "finding",
        "observation_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "finding": {
                "pattern": "\\S"
              }
            },
            "required": [
              "finding"
            ]
          },
          "then": {
            "properties": {
              "observation_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "ClaimUpdate": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S"
        },
        "requirement": {
          "type": "string",
          "maxLength": 1200,
          "minLength": 1,
          "pattern": "\\S"
        },
        "finding": {
          "type": "string",
          "maxLength": 1200
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "\\S"
          },
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1,
      "dependentRequired": {
        "finding": [
          "observation_ids"
        ],
        "observation_ids": [
          "finding"
        ]
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "claim_id"
              ]
            }
          },
          "then": {
            "required": [
              "requirement"
            ]
          }
        },
        {
          "if": {
            "required": [
              "finding"
            ],
            "properties": {
              "finding": {
                "pattern": "\\S"
              }
            }
          },
          "then": {
            "properties": {
              "observation_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Focus": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S"
        },
        "need": {
          "type": "string",
          "maxLength": 800,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "claim_id",
        "need"
      ],
      "additionalProperties": false
    },
    "ResearchState": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/Focus"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "answer",
        "claims",
        "focus"
      ],
      "additionalProperties": false
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "search"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "maxLength": 2000,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "focus": {
                  "$ref": "#/$defs/Focus"
                },
                "anchor_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "top_k": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "required": [
                "query"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "action",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "open_page"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "docid": {
                  "type": "string",
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "search_action_id": {
                  "type": "string",
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "query": {
                  "type": "string",
                  "maxLength": 2000,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "docid"
              ],
              "additionalProperties": false,
              "not": {
                "required": [
                  "query",
                  "offset"
                ]
              }
            }
          },
          "required": [
            "action",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "read_evidence"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "observation_id": {
                  "type": "string",
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "directory_cursor": {
                  "type": "string",
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [],
              "additionalProperties": false,
              "oneOf": [
                {
                  "required": [
                    "observation_id"
                  ],
                  "not": {
                    "required": [
                      "directory_cursor"
                    ]
                  }
                },
                {
                  "required": [
                    "directory_cursor"
                  ],
                  "not": {
                    "required": [
                      "observation_id"
                    ]
                  }
                }
              ]
            }
          },
          "required": [
            "action",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "update_state"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "target": {
                  "type": "string",
                  "maxLength": 2000,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "answer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000,
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "claim_updates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ClaimUpdate"
                  },
                  "maxItems": 64
                },
                "retire_claim_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "focus": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Focus"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dismiss_observation_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "attempt_note": {
                  "type": "string",
                  "maxLength": 800,
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "revision_reason": {
                  "type": "string",
                  "maxLength": 1200,
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [],
              "additionalProperties": false,
              "minProperties": 1
            }
          },
          "required": [
            "action",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "verify_answer"
            },
            "arguments": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "action",
            "arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "submit_answer"
            },
            "arguments": {
              "type": "object",
              "properties": {
                "decision": {
                  "type": "string",
                  "enum": [
                    "answer",
                    "abstain"
                  ],
                  "default": "answer"
                },
                "reason": {
                  "type": "string",
                  "maxLength": 800,
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "action",
            "arguments"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/Action"
}