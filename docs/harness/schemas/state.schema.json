{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "answer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "finding": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1800
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": [
          "claim_id",
          "requirement",
          "finding",
          "observation_ids"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "minItems": 1
    },
    "focus": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "claim_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "need": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "claim_id",
            "need"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "target",
    "answer",
    "claims",
    "focus"
  ],
  "additionalProperties": false
}
