{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "supported",
            "unknown",
            "contradicted"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "need": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        }
      },
      "required": [
        "status",
        "reason",
        "need"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "supported",
            "unknown",
            "contradicted"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "need": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        }
      },
      "required": [
        "status",
        "reason",
        "need"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "supported",
              "unknown",
              "contradicted"
            ]
          },
          "quotes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "observation_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "observation_id",
                "quote"
              ],
              "additionalProperties": false
            },
            "maxItems": 16
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "need": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          }
        },
        "required": [
          "claim_id",
          "status",
          "quotes",
          "reason",
          "need"
        ],
        "additionalProperties": false
      },
      "maxItems": 16
    }
  },
  "required": [
    "target",
    "coverage",
    "claims"
  ],
  "additionalProperties": false
}
